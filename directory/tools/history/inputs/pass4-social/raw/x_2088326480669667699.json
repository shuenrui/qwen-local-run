  {
   "id": "2088343272859070972",
   "text": "@analogalok a few months ago Opus was the same speed and quality at 25$  per million output token🤯",
   "author": {
    "id": "1472607185167343622",
    "name": "tani",
    "screenName": "tani111_111",
    "profileImageUrl": "https://pbs.twimg.com/profile_images/2085754704076709888/2l2Xnj8t_normal.jpg",
    "verified": true
   },
   "metrics": {
    "likes": 1,
    "retweets": 0,
    "replies": 1,
    "quotes": 0,
