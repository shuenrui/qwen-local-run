# Profile: Qwen3-30B-A3B MoE (FP8) — pre-hybrid generation baseline.
# Usage: PROFILE=profiles/qwen3.0-30b-a3b-fp8.env ./start-model.sh mtp
# 30.5B total / 3.3B active, pure Transformer (no Gated DeltaNet), 131k ctx.
# Shows what the GDN hybrid bought us vs Wave-1 MoEs. No MTP head: spec OFF.

MODEL_ID=Qwen/Qwen3-30B-A3B-FP8
SERVED_MODEL_NAME=qwen3.0-30b-a3b-sglang
CONTAINER_NAME=qwen3.0-30b-a3b-sglang
PORT=8888
IMAGE=lmsysorg/sglang:qwen38-27b
ENGINE=sglang

QUANT=fp8
YARN=0
CONTEXT_LENGTH=131072
MAX_CONCURRENT_REQUESTS=10
MEM_FRACTION_STATIC=0.85
SPEC_ENABLE=0
CHUNKED_PREFILL=8192
#CPUSET=5-9,15-19
