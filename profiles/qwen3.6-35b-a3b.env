# Profile: Qwen3.6-35B-A3B (MoE, 35B total / 3B active) — challenger for A/B.
# Usage: PROFILE=profiles/qwen3.6-35b-a3b.env ./start-model.sh
#
# Weights: nvidia/Qwen3.6-35B-A3B-NVFP4 (ModelOpt v0.44, ~21-24GB).
#   Fallbacks: unsloth/Qwen3.6-35B-A3B-NVFP4 (tool-call +6.7%, 83.8 tok/s vLLM),
#   Qwen/Qwen3.6-35B-A3B-FP8 (needs chat-template fix, wins single-stream latency).
# Cookbook: SGLang >=0.5.10, EAGLE 3/1/4, qwen3 + qwen3_coder parsers, 262144 ctx.
# SGLang image: reuses qwen38-27b (same GDN+MoE family). If boot rejects
#   qwen3_5_moe arch, set IMAGE=lmsysorg/sglang:v0.5.15-cu130 (first release
#   with native ModelOpt mixed-precision load, no patch needed).

MODEL_ID=nvidia/Qwen3.6-35B-A3B-NVFP4
SERVED_MODEL_NAME=qwen3.6-35b-a3b-sglang
CONTAINER_NAME=qwen3.6-35b-a3b-sglang
PORT=8888
IMAGE=lmsysorg/sglang:qwen38-27b

QUANT=nvfp4
YARN=0
CONTEXT_LENGTH=262144
MAX_CONCURRENT_REQUESTS=10
# SGLang mem fraction: 3.6 cookbook/DGX runs use 0.80-0.85 (vs 0.95 on 3.8/MTP).
MEM_FRACTION_STATIC=0.85
SPEC_STEPS=3
SPEC_TOPK=1
SPEC_DRAFT=4
CHUNKED_PREFILL=8192
#CPUSET=5-9,15-19
