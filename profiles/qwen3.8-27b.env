# Profile: Qwen3.8-27B (dense) — current production defaults.
# Usage: PROFILE=profiles/qwen3.8-27b.env ./start-model.sh
# (Shell env wins > profile file > start.sh defaults.)

# Explicit model identity (wins over QUANT mapping in start.sh):
MODEL_ID=RadixArk/Qwen3.8-27B-NVFP4-BF16-LMHead
SERVED_MODEL_NAME=qwen3.8-27b-sglang
CONTAINER_NAME=qwen3.8-27b-sglang
PORT=8888
IMAGE=lmsysorg/sglang:qwen38-27b

# Checkpoint selector (kept for docs; ignored when MODEL_ID is set):
#   nvfp4 = BF16 lm_head (default, cookbook-measured) | nvfp4-fp4 = packed FP4 head
QUANT=nvfp4

YARN=0
CONTEXT_LENGTH=262144
MAX_CONCURRENT_REQUESTS=16
MEM_FRACTION_STATIC=0.95
# MTP 3/1/4 is the measured peak for this model; DSpark path uses start-dspark.sh instead.
#SPEC_STEPS=3
#SPEC_TOPK=1
#SPEC_DRAFT=4
#CHUNKED_PREFILL=8192
#CPUSET=5-9,15-19
