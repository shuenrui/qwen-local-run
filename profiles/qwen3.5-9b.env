# Profile: Qwen3.5-9B dense (BF16) — cheap + shockingly smart.
# Usage: PROFILE=profiles/qwen3.5-9b.env ./start-model.sh mtp
# ~18GB BF16, fits anywhere. MMLU-Pro 82.5 punches far above its weight.
# Small models carry no MTP head, so speculative decoding is OFF here.

MODEL_ID=Qwen/Qwen3.5-9B
SERVED_MODEL_NAME=qwen3.5-9b-sglang
CONTAINER_NAME=qwen3.5-9b-sglang
PORT=8888
IMAGE=lmsysorg/sglang:qwen38-27b
ENGINE=sglang

QUANT=bf16
YARN=0
CONTEXT_LENGTH=131072
MAX_CONCURRENT_REQUESTS=16
MEM_FRACTION_STATIC=0.90
SPEC_ENABLE=0
CHUNKED_PREFILL=8192
#CPUSET=5-9,15-19
