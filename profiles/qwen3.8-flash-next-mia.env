# Profile (STANDBY, manual-only): Qwen3.8-Flash-Next 180B via Mia's single-Spark repo.
# ENGINE=vllm — start-model.sh WILL REFUSE auto-boot for this card.
# Run it from her repo instead:
#   https://github.com/MiaAI-Lab/Qwen3.8-Flash-Next-Single-DGX-Spark
#   cp .env.sample .env && ./download.sh && ./start.sh   # ~99GB + 27GB table
# Her stack: vLLM TP=1, PLE table mmap'd from disk, FP8 KV default, MTP-3,
# 262144 native (YARN=1 -> 524288), port 8888, AGPL scripts.
# This card exists so bench/ab.py + UI list the lane and record its numbers
# once YOU have her server up (point PORT at it, auto=false).

MODEL_ID=Mia-AiLab/Qwen3.8-Flash-Next-NVFP4
SERVED_MODEL_NAME=qwen3.8-flash-next
CONTAINER_NAME=vllm-fn-tp1
PORT=8888
IMAGE=vllm/vllm-openai:qwen38-flash-next
ENGINE=vllm

QUANT=nvfp4
YARN=0
CONTEXT_LENGTH=262144
MAX_CONCURRENT_REQUESTS=4
MEM_FRACTION_STATIC=0.78
SPEC_ENABLE=1
SPEC_STEPS=3
SPEC_TOPK=1
SPEC_DRAFT=4
CHUNKED_PREFILL=2048
