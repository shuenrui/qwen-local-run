# Profile (EXPERIMENTAL, boot UNVERIFIED): PrismML Ternary Bonsai 2 27B via a
# community native repack — fraserprice/Ternary-Bonsai-2-27B-vllm (safetensors,
# 3 shards, tagged vllm/2-bit/cuda). Base: Qwen3.8-27B; ternary weights
# {-1,0,+1} + FP16 scales, ~5.9 GB, Apache 2.0.
# Why this repo: the official PrismML collection ships GGUF + MLX only (their
# llama.cpp fork / Apple MLX — neither boots under SGLang on this box). This
# repack is the only known HF-native checkpoint of Bonsai-2.
# Boot expectation: ternary weights almost certainly need custom kernels
# (GemLite-style), so a stock SGLang boot may FAIL on weight loading. That is
# a clean slot error, not an arena bug — but do NOT auto-run it blind against
# a live job. FIRST TRY is manual boot + arena Run with auto OFF:
#   PROFILE=profiles/ternary-bonsai-2-27b-vllm.env ./start-model.sh mtp
# If SGLang rejects it, the honest fallback is a vLLM manual lane
# (ENGINE=vllm, boot from its own launcher, auto OFF) like qwen3.5-122b-albond.
# ENGINE stays sglang for now so the UI Download button works (/api/download
# refuses non-sglang lanes) and the card appears as a real contender.
# Usage: PROFILE=profiles/ternary-bonsai-2-27b-vllm.env ./start-model.sh mtp
# (Shell env wins > profile file > start.sh defaults.)

MODEL_ID=fraserprice/Ternary-Bonsai-2-27B-vllm
SERVED_MODEL_NAME=ternary-bonsai-2-27b-vllm
CONTAINER_NAME=ternary-bonsai-2-27b-vllm
PORT=8888
IMAGE=lmsysorg/sglang:qwen38-27b
ENGINE=sglang

# QUANT is docs-only when MODEL_ID is explicit (start.sh mapping skipped):
QUANT=ternary-2bit

YARN=0
CONTEXT_LENGTH=262144
MAX_CONCURRENT_REQUESTS=10
MEM_FRACTION_STATIC=0.85
# No MTP/draft head on a ternary repack: SPEC_ENABLE=0 omits all spec flags.
SPEC_ENABLE=0
CHUNKED_PREFILL=8192
#CPUSET=5-9,15-19
