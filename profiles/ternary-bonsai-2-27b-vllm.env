# Profile (MANUAL-ONLY, verified 2026-09-20): PrismML Ternary Bonsai 2 27B via
# a community native repack — fraserprice/Ternary-Bonsai-2-27B-vllm
# (safetensors, 3 shards, tagged vllm/2-bit/cuda). Base: Qwen3.8-27B; ternary
# weights {-1,0,+1} + FP16 scales, ~5.9 GB, Apache 2.0.
# Why this repo: the official PrismML collection ships GGUF + MLX only (their
# llama.cpp fork / Apple MLX — neither boots under SGLang on this box). This
# repack is the only known HF-native checkpoint of Bonsai-2.
# VERIFIED BOOT BLOCKER (do not flip ENGINE back to sglang): the repack's
# config.json declares quantization_config.quant_method = "prism_ternary"
# (Hadamard-rotated 2-bit + FP16 group scales). Stock SGLang rejects it at
# arg-parse time — "Unknown quantization method: prism_ternary" (see
# /tmp/arena.log 2026-09-20; container_confirmed dead, clean slot error).
# WORKING (verified 2026-09-20, ~25 tok/s, 262k ctx): host-side vLLM 0.25.1
# (aarch64 wheel) + torch 2.11 cu130 + prism-ternary plugin from
# https://github.com/fraserprice/bonsai-vllm, kernels compiled with nvcc 13
# for sm_121. Venv: ~/.venvs/bonsai-vllm (isolated; system python untouched).
# Weights: user-owned copy at ~/.cache/bonsai-hf/hub (arena cache is
# root-owned; trees/ skipped — regenerable). Python headers came from
# apt-get download (dpkg-deb -x to ~/.pylibs, CPATH) — no sudo needed.
# Boot (GPU must be free — stop SGLang first; takes ~5 min cold, ~3 warm):
#   export PATH=~/.venvs/bonsai-vllm/bin:$PATH \
#     CPATH=~/.pylibs/usr/include/python3.12:~/.pylibs/usr/include \
#     TORCH_CUDA_ARCH_LIST="12.0 12.1" \
#     TORCH_EXTENSIONS_DIR=~/.cache/bonsai-hf/torch_ext \
#     HF_HOME=~/.cache/bonsai-hf/hub HF_HUB_CACHE=~/.cache/bonsai-hf/hub \
#     HF_HUB_OFFLINE=1 VLLM_CACHE_ROOT=~/.cache/bonsai-hf/vllm \
#     TRITON_CACHE_DIR=~/.cache/bonsai-hf/triton
#   setsid nohup python -m vllm.entrypoints.openai.api_server \
#     --model fraserprice/Ternary-Bonsai-2-27B-vllm \
#     --served-model-name ternary-bonsai-2-27b-vllm --host 0.0.0.0 \
#     --port 8888 --max-model-len 262144 --max-num-seqs 32 \
#     --max-num-batched-tokens 8192 --enable-prefix-caching \
#     --language-model-only --reasoning-parser qwen3 \
#     --enable-auto-tool-choice --tool-call-parser qwen3_coder \
#     --speculative-config '{"method":"mtp","num_speculative_tokens":7}' \
#     >/tmp/bonsai-8888.log 2>&1 </dev/null &
# Stop before any arena auto run (host process — stop.sh cannot see it):
#   kill <pid>   # PID from: ss -ltnp | grep :8888
# To compete: boot per above, then arena Run with auto OFF.
# Until someone boots that successfully: ENGINE=vllm, i.e. manual lane.
# start-model.sh REFUSES vllm lanes; the UI greys the card out. To compete:
# boot the image yourself, then arena Run with auto OFF (arena just hits
# :8888 with SERVED_MODEL_NAME, no boot attempted).
# NOTE: /api/download refuses non-sglang lanes — moot, weights are cached
# (9.55 GB, snapshots/1e1d7c0f...). Do NOT re-download.
# Usage (after manual boot): select card, untick auto, Run.

MODEL_ID=fraserprice/Ternary-Bonsai-2-27B-vllm
SERVED_MODEL_NAME=ternary-bonsai-2-27b-vllm
CONTAINER_NAME=ternary-bonsai-2-27b-vllm
PORT=8888
IMAGE=lmsysorg/sglang:qwen38-27b
ENGINE=vllm

# QUANT is docs-only when MODEL_ID is explicit (start.sh mapping skipped):
QUANT=ternary-2bit

YARN=0
CONTEXT_LENGTH=262144
MAX_CONCURRENT_REQUESTS=10
MEM_FRACTION_STATIC=0.85
# No MTP/draft head on a ternary repack: SPEC_ENABLE=0 omits all spec flags.
SPEC_ENABLE=0
CHUNKED_PREFILL=8192
#CPUSET=5-9,15-19
