# Profile: Qwen3.6-27B dense (FP8) — the missing sibling.
# Usage: PROFILE=profiles/qwen3.6-27b-fp8.env ./start-model.sh mtp
# Official Qwen FP8 (~28GB). Dense 27B like the 3.8-27B: wake-all-every-word.
# NOTE: MTP head presence unverified on this checkpoint — if boot rejects
# EAGLE spec, set SPEC_ENABLE=0 and relaunch.

MODEL_ID=Qwen/Qwen3.6-27B-FP8
SERVED_MODEL_NAME=qwen3.6-27b-fp8-sglang
CONTAINER_NAME=qwen3.6-27b-fp8-sglang
PORT=8888
IMAGE=lmsysorg/sglang:qwen38-27b
ENGINE=sglang

QUANT=fp8
YARN=0
CONTEXT_LENGTH=262144
MAX_CONCURRENT_REQUESTS=10
MEM_FRACTION_STATIC=0.90
SPEC_ENABLE=1
SPEC_STEPS=3
SPEC_TOPK=1
SPEC_DRAFT=4
CHUNKED_PREFILL=8192
#CPUSET=5-9,15-19
