# Profile (STANDBY, manual-only): Qwen3.5-122B-A10B via Albond INT4-hybrid.
# ENGINE=vllm — start-model.sh WILL REFUSE auto-boot for this card.
# Run it from his repo instead:
#   https://github.com/albond/DGX_Spark_Qwen3.5-122B-A10B-AR-INT4
# 122B total / 10B active MoE, ~67GB hybrid INT4+FP8 + MTP-2, 256k ctx.
# Best documented single-Spark 100B recipe (52 tok/s, 54.9 LongCode peak).
# This card exists so bench/ab.py + UI list the lane and record its numbers
# once YOU have his server up (point PORT at it, auto=false).

MODEL_ID=Intel/Qwen3.5-122B-A10B-int4-AutoRound
SERVED_MODEL_NAME=qwen3.5-122b-a10b
CONTAINER_NAME=qwen3.5-122b-vllm
PORT=8888
IMAGE=vllm-vllm-openai-albond
ENGINE=vllm

QUANT=int4-hybrid
YARN=0
CONTEXT_LENGTH=262144
MAX_CONCURRENT_REQUESTS=4
MEM_FRACTION_STATIC=0.80
SPEC_ENABLE=1
SPEC_STEPS=2
SPEC_TOPK=1
SPEC_DRAFT=3
CHUNKED_PREFILL=8192
