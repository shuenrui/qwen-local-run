# Profile: Qwen3.8-27B via RedHatAI NVFP4 — enterprise alt to RadixArk/Unsloth.
# Usage: PROFILE=profiles/qwen3.8-27b-redhat-nvfp4.env ./start-model.sh mtp
# Refreshed 2026-09-02. Same dense 27B body, different chef's 4-bit.
# A/B vs profiles/qwen3.8-27b.env isolates *whose NVFP4* at fixed model.

MODEL_ID=RedHatAI/Qwen3.8-27B-NVFP4
SERVED_MODEL_NAME=qwen3.8-27b-redhat-sglang
CONTAINER_NAME=qwen3.8-27b-redhat-sglang
PORT=8888
IMAGE=lmsysorg/sglang:qwen38-27b
ENGINE=sglang

QUANT=nvfp4
YARN=0
CONTEXT_LENGTH=262144
MAX_CONCURRENT_REQUESTS=16
MEM_FRACTION_STATIC=0.90
SPEC_ENABLE=1
SPEC_STEPS=3
SPEC_TOPK=1
SPEC_DRAFT=4
CHUNKED_PREFILL=8192
#CPUSET=5-9,15-19
