# Profile: Qwen3-32B dense (FP8) — pre-hybrid dense baseline.
# Usage: PROFILE=profiles/qwen3.0-32b-fp8.env ./start-model.sh mtp
# 32.5B dense, pure Transformer, 131k ctx. Dense-vs-dense vs 3.8-27B:
# isolates architecture generation at fixed serving stack. No MTP: spec OFF.

MODEL_ID=Qwen/Qwen3-32B-FP8
SERVED_MODEL_NAME=qwen3.0-32b-sglang
CONTAINER_NAME=qwen3.0-32b-sglang
PORT=8888
IMAGE=lmsysorg/sglang:qwen38-27b
ENGINE=sglang

QUANT=fp8
YARN=0
CONTEXT_LENGTH=131072
MAX_CONCURRENT_REQUESTS=10
MEM_FRACTION_STATIC=0.90
SPEC_ENABLE=0
CHUNKED_PREFILL=8192
#CPUSET=5-9,15-19
